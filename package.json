{
  "name": "crm-neon-mcp",
  "version": "1.0.0",
  "description": "MCP server for two Neon Postgres CRM databases with CEO and manager access controls.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/http-server.ts",
    "dev:stdio": "tsx src/stdio-server.ts",
    "start": "node dist/src/http-server.js",
    "start:stdio": "node dist/src/stdio-server.js",
    "db:setup": "tsx scripts/setup-neon.ts",
    "embeddings:refresh": "tsx scripts/refresh-embeddings.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@types/express": "^5.0.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
