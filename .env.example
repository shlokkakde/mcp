# Neon admin URL points to the default database in your one Neon project.
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_ADMIN_DATABASE_URL=

# Optional. If blank, db:setup and the server derive these from NEON_ADMIN_DATABASE_URL.
# Example: postgresql://USER:PASSWORD@HOST/deep_crm?sslmode=require
DEEP_DATABASE_URL=
POOJAN_DATABASE_URL=

# Actor identity is server-side configuration, not a tool argument.
# Try: deep_ceo, poojan_ceo, deep_manager_1, deep_manager_2,
#      poojan_manager_1, poojan_manager_2
MCP_ACTOR_ID=deep_ceo

# Keep false for production-like safety. Set true only for classroom demos
# when you want ChatGPT to switch between demo actors without restarting.
MCP_ALLOW_DEMO_ACTOR_SWITCH=false

# HTTP/OAuth mode for ChatGPT remote MCP connections.
# On Vercel, set PUBLIC_BASE_URL and OAUTH_ISSUER to your deployed https:// URL.
PORT=8787
PUBLIC_BASE_URL=https://your-mcp-domain.example
OAUTH_ISSUER=https://your-mcp-domain.example
AUTH_JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=3600

# Optional task assignment emails through Gmail SMTP.
# Use a Gmail app password, not your normal Gmail password.
# If either GMAIL_USER or GMAIL_APP_PASSWORD is blank, tasks are still created and email is skipped.
GMAIL_USER=your.gmail.account@gmail.com
GMAIL_APP_PASSWORD=
TASK_NOTIFICATION_FROM_EMAIL=CRM Demo <your.gmail.account@gmail.com>

# Demo login accounts. Change these to any emails you want.
DEEP_CEO_EMAIL=deep.ceo@crm.example
DEEP_CEO_PASSWORD=deep-ceo-pass
POOJAN_CEO_EMAIL=poojan.ceo@crm.example
POOJAN_CEO_PASSWORD=poojan-ceo-pass
DEEP_MANAGER_1_EMAIL=deep.manager1@crm.example
DEEP_MANAGER_1_PASSWORD=manager-pass
DEEP_MANAGER_2_EMAIL=deep.manager2@crm.example
DEEP_MANAGER_2_PASSWORD=manager-pass
POOJAN_MANAGER_1_EMAIL=poojan.manager1@crm.example
POOJAN_MANAGER_1_PASSWORD=manager-pass
POOJAN_MANAGER_2_EMAIL=poojan.manager2@crm.example
POOJAN_MANAGER_2_PASSWORD=manager-pass

# Required only for semantic search / embeddings.
# Use openai or gemini. If GEMINI_API_KEY is set and OPENAI_API_KEY is empty, gemini is selected automatically.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
